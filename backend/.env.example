# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored: never commit real secrets.

# development | production (production enables secure cookies)
NODE_ENV=development

# Port the API listens on
PORT=3001

# PostgreSQL connection string (matches docker-compose.yml for local development)
DATABASE_URL=postgresql://homefix:homefix@localhost:5432/homefix

# Secret used to sign login tokens: at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Login token lifetime in seconds (default 86400 = 1 day)
AUTH_TOKEN_EXPIRES_IN_SECONDS=86400

# Optional: folder for uploaded repair photos (default backend/storage/repair-photos)
# HOMEFIX_UPLOAD_DIR=
